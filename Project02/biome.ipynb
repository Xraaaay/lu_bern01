    "def draw_heatmap(df: pd.DataFrame):\n",
    "    corr_matrix = df.corr()\n",
    "\n",
    "    figure, ax = plt.subplots(figsize=(12, 10))\n",
    "    sns.heatmap(corr_matrix, cmap=\"coolwarm\", annot=True, fmt=\".2f\", vmin=-1, vmax=1, center=0)\n",
    "\n",
    "    ax.set_title(\"Feature Correlation Heatmap\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
