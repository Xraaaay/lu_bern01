  {
   "cell_type": "markdown",
   "id": "13ef74aa",
   "metadata": {},
   "source": [
    "#### 4.2.3. Hyperparameter Tuning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "0573b1dd",
   "metadata": {},
   "outputs": [],
   "source": [
    "TUNE_HYPER_PARAM = False"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 50,
   "id": "ac6c80fd",
   "metadata": {},
   "outputs": [],
   "source": [
    "if TUNE_HYPER_PARAM:\n",
    "    folds = KFold(5, random_state=7, shuffle=True)\n",
    "\n",
    "    param_grid = {\n",
    "        \"n_estimators\": [180, 200, 220, 240],\n",
    "        \"max_depth\": [18, 20, 22, None],\n",
    "        \"min_samples_leaf\": [1, 2, 4],\n",
    "        \"max_features\": [\"sqrt\", \"log2\", None]\n",
    "    }\n",
    "\n",
    "    rfc_gscv = GridSearchCV(\n",
    "        rfc_multi,\n",
    "        param_grid=param_grid,\n",
    "        scoring=\"f1_macro\",\n",
    "        cv=folds,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "    rfc_gscv.fit(X, y)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "0b0dadda",
   "metadata": {},
   "outputs": [],
   "source": [
    "if TUNE_HYPER_PARAM:\n",
    "    joblib.dump(rfc_gscv.best_estimator_, \"./output/best_rf_multi.pkl\")"
   ]
  },
